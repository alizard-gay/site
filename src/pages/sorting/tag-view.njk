---
pagination:
  data: collections
  size: 1
  alias: tag
permalink: /blog/tags/{{ tag }}/
layout: layouts/base.njk
filter:
  - all
  - post
  - posts
  - blogTags
  - badges
  - site
eleventyComputed:
  title: "Posts tagged with “{{ tag }}”"
---
<h2>Tagged “{{ tag }}”</h2>
<ol>
{% set taglist = collections[ tag ] %}
{% for post in taglist | reverse %}
  <li><a href="{{ post.url }}">{{ post.data.title }}</a></li>
{% endfor %}
</ol>