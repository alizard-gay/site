---
permalink: /discord/embeds/todo.json
---
{
  "component": {
    "type": 17,
    "accent_color": 5793266,
    "components": [
      {
        "type": 10,
        "content": "## To-do list"
      },
    {% for item in todo.list %}
      {
        "type": 10,
        "content": "- {{ item.text }}"
      }{% if not loop.last %},{% endif %}
    {% endfor %}
    ]
  }
}