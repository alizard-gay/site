<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark">
    <title>{{ title or "alizard.gay" }}</title>
    {% if ogtitle %}
    <meta property="og:title" content="{{ogtitle}}" />
    {% endif %}
    {% if description %}
    <meta name="description" content="{{ description }}">
    {% endif %}
    <meta property="og:type" content="{{ type | default('website') }}">
    {% if type == "article" %}
    <meta property="article:author" content="{{ author | default('https://alizard.gay/~alizard/') }}" />
        {% if date %}
        <meta property="article:published_time" content="{{ date.toISOString() }}}" />
        {% endif %}
        {% if updated %}
        <meta property="article:article:modified_time" content="{{ updated.toISOString() }}}" />
        {% endif %}
    {% endif %}
    {% if image %}
        <meta property="og:image" content="https://alizard.gay/{{ image }}">
        <meta name="twitter:card" content="{{ imagetype | default('summary') }}">
        {% if imagealt %}
            <meta property="og:image:alt" content="{{ imagealt }}">
        {% endif %}
    {% endif %}
    <meta property="og:site_name" content="alizard.gay">

    <link rel="stylesheet" href="/assets/css/base.css">
    {% if style %}
    <link rel="stylesheet" href="/assets/css/{{ style }}">
    {% endif %}
    
    <link rel="icon" type="image/png" href="/favicon/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="alizard.gay" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
</head>
<body>
    {% include "partials/header.njk" %}
    <main>
        {{ content | safe }}
    </main>
</body>
</html>