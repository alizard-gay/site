export async function onRequest(context) {
  const url = new URL(context.request.url);
  const resource = url.searchParams.get("resource");

  // Only allow requests specifically for your exact identity
  if (resource === "acct:me@alizard.gay") {
    // Fetch the static file generated by 11ty
    const response = await context.next();
    
    // Create a new response to ensure correct headers are injected
    return new Response(response.body, {
      status: 200,
      headers: {
        "Content-Type": "application/jrd+json; charset=utf-8",
        "Access-Control-Allow-Origin": "*",
        "Cache-Control": "public, max-age=3600"
      }
    });
  }

  // Block everything else with a 404
  return new Response("Not Found", { status: 404 });
}
